{
  "baseURL": "https://captua.org/",
  "title": "Captua",
  "defaultContentLanguage": "en",
  "defaultContentLanguageInSubdir": false,
  "disableKinds": [
    "taxonomy",
    "term",
    "RSS"
  ],
  "languages": {
    "en": {
      "contentDir": "content/en",
      "weight": 1,
      "languageCode": "en",
      "languageName": "English"
    },
    "es": {
      "contentDir": "content/es",
      "weight": 2,
      "languageCode": "es",
      "languageName": "Español",
      "disabled": false
    }
  },
  "markup": {
    "goldmark": {
      "renderer": {
        "unsafe": true
      },
      "parser": {
        "attribute": {
          "title": true,
          "block": true
        }
      }
    },
    "highlight": {
      "noClasses": false
    }
  },
  "params": {
    "docs_preview": false,
    "api_reference": "/docs/developers/api-reference/",
    "repository": "https://github.com/UCSB-AMPLab/captua-docs"
  },
  "enableRobotsTXT": true,
  "disableDefaultSiteRedirect": true
}
